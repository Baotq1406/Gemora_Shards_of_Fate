# Dependencies installed by npm (keep package.json and package-lock.json)
node_modules/
apps/game-server/src/generated/

# Generated builds, test reports, and tool caches
dist/
dist-ssr/
build/
coverage/
playwright-report/
blob-report/
test-results/
# Playwright authentication state can contain cookies and access tokens
**/playwright/.auth/
.nyc_output/
.vite/
.vite-temp/
.cache/
.turbo/
.eslintcache
.prettiercache
*.tsbuildinfo
# Temporary modules created while loading Vite configuration
vite.config.*.timestamp-*

# Logs and local process files
logs/
*.log
*.pid
*.pid.lock

# Environment values and machine-specific configuration
.env
.env.*
*.local
# Templates must contain placeholder values only
!.env.example
!.env.*.example
!.env.sample
!.env.*.sample

# Local secrets and private key material
secrets/
*.key
*.p12
*.pfx
*.keystore
id_rsa
id_ed25519

# Local runtime data and backups (root directories only)
/data/
/backups/
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm

# Generated CodeGraph index, reproducible from source
.codegraph/

# Personal editor state; allow selected team configuration
.idea/
**/.vscode/*
!**/.vscode/extensions.json
!**/.vscode/tasks.json
!**/.vscode/launch.json
*.code-workspace
*.suo
*.user

# OS metadata and temporary files
.DS_Store
Thumbs.db
Desktop.ini
# Office lock files; keep the actual documents
~$*.docx
~$*.xlsx
~$*.pptx
*.tmp
*.temp
*.swp
*.swo
*~
/tmp/
/temp/
