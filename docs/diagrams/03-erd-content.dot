digraph Gemora {
graph [bgcolor="white", pad="0.35", nodesep="0.5", ranksep="0.7", splines=polyline, rankdir=TB, fontname="Arial", fontsize=17, color="black"];
node [shape=box, style=filled, fillcolor="white", color="black", fontcolor="black", fontname="Arial", fontsize=17, penwidth=1.4, margin="0.18,0.12"];
edge [color="black", fontcolor="black", fontname="Arial", fontsize=14, penwidth=1.25, arrowsize=0.7, arrowhead=none];

r [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="black" BGCOLOR="white"><TR><TD ALIGN="LEFT" BORDER="1" SIDES="B"><FONT POINT-SIZE="17"><B>ContentRelease</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">PK id · UQ version</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">DRAFT / PUBLISHED / ARCHIVED</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">publishedAt</FONT></TD></TR></TABLE>>];
hd [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="black" BGCOLOR="white"><TR><TD ALIGN="LEFT" BORDER="1" SIDES="B"><FONT POINT-SIZE="17"><B>HeroDefinition</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">PK id · FK releaseId</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">FK heroCode → HeroCatalog</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">element / role / stats / growth</FONT></TD></TR></TABLE>>];
skill [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="black" BGCOLOR="white"><TR><TD ALIGN="LEFT" BORDER="1" SIDES="B"><FONT POINT-SIZE="17"><B>SkillDefinition</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">PK id · FK releaseId</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">code / cost / cooldown</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">target / effect JSONB</FONT></TD></TR></TABLE>>];
hs [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="black" BGCOLOR="white"><TR><TD ALIGN="LEFT" BORDER="1" SIDES="B"><FONT POINT-SIZE="17"><B>HeroSkill</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">PK (heroDefinitionId, skillId)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">FK heroDefinitionId / skillId</FONT></TD></TR></TABLE>>];
world [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="black" BGCOLOR="white"><TR><TD ALIGN="LEFT" BORDER="1" SIDES="B"><FONT POINT-SIZE="17"><B>World</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">PK id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">name / order</FONT></TD></TR></TABLE>>];
chapter [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="black" BGCOLOR="white"><TR><TD ALIGN="LEFT" BORDER="1" SIDES="B"><FONT POINT-SIZE="17"><B>Chapter</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">PK id · FK worldId</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">name / order</FONT></TD></TR></TABLE>>];
stage [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="black" BGCOLOR="white"><TR><TD ALIGN="LEFT" BORDER="1" SIDES="B"><FONT POINT-SIZE="17"><B>Stage</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">PK id · FK chapterId</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">code / order ổn định</FONT></TD></TR></TABLE>>];
sv [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="black" BGCOLOR="white"><TR><TD ALIGN="LEFT" BORDER="1" SIDES="B"><FONT POINT-SIZE="17"><B>StageVersion</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">PK id · FK stageId / releaseId</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">prerequisites / turnLimit</FONT></TD></TR></TABLE>>];
enemy [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="black" BGCOLOR="white"><TR><TD ALIGN="LEFT" BORDER="1" SIDES="B"><FONT POINT-SIZE="17"><B>EnemyDefinition</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">PK id · FK releaseId</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">code / stats / AI / skills</FONT></TD></TR></TABLE>>];
se [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="black" BGCOLOR="white"><TR><TD ALIGN="LEFT" BORDER="1" SIDES="B"><FONT POINT-SIZE="17"><B>StageEnemy</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">PK (stageVersionId, slot)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">FK stageVersionId / enemyId</FONT></TD></TR></TABLE>>];
reward [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="black" BGCOLOR="white"><TR><TD ALIGN="LEFT" BORDER="1" SIDES="B"><FONT POINT-SIZE="17"><B>RewardDefinition</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">PK id · FK stageVersionId</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">CLEAR / FIRST_CLEAR</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">bundle: Gold / EXP / item / hero</FONT></TD></TR></TABLE>>];
balance [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="black" BGCOLOR="white"><TR><TD ALIGN="LEFT" BORDER="1" SIDES="B"><FONT POINT-SIZE="17"><B>BalanceConfig</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">PK id · FK UQ releaseId</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="14">upgradeCosts / combatConfig</FONT></TD></TR></TABLE>>];
r -> hd [label="1 : 0..N"]; r -> skill [label="1 : 0..N"]; r -> sv [label="1 : 0..N"]; r -> enemy [label="1 : 0..N"]; r -> balance [label="1 : 1 khi publish"];
world -> chapter [label="1 : 0..N"]; chapter -> stage [label="1 : 0..N"]; stage -> sv [label="1 : 0..N"];
hd -> hs [label="1 : 0..N"]; skill -> hs [label="1 : 0..N"];
sv -> se [label="1 : 0..N"]; enemy -> se [label="1 : 0..N"]; sv -> reward [label="1 : 0..N"];
{rank=same; hd; skill; sv; enemy; balance;}

}
