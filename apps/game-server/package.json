{
  "name": "@gemora/game-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "test:docs": "tsx --test test/api-docs.test.ts",
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate:create": "prisma migrate dev --create-only",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:apply": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:check": "tsx scripts/check-db.ts",
    "test:db": "tsx --test test/database.integration.test.ts test/onboarding.database.test.mjs",
    "test:auth": "tsx --test test/auth.integration.test.ts test/google.provider.test.ts"
  },
  "dependencies": {
    "@gemora/shared-types": "0.0.0",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/swagger": "12.1.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.2",
    "dotenv": "17.4.2",
    "google-auth-library": "11.3.3",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "12.3.2",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
