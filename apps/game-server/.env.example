# Copy to .env and replace the password locally (URL-encode special characters).
DATABASE_URL="postgresql://gemora_app:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:5432/gemora_dev?schema=public"
# Separate disposable database used ONLY while creating migrations.
SHADOW_DATABASE_URL="postgresql://gemora_app:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:5432/gemora_shadow?schema=public"
HOST=127.0.0.1
PORT=3000
# Public frontend origin; browser requests go through its /api proxy.
APP_ORIGIN=http://localhost:8080
# Optional: true/false. When omitted, enabled outside production only.
# API_DOCS_ENABLED=true
SESSION_TTL_DAYS=7
# Leave blank until a Google Web application OAuth client has been created.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback
